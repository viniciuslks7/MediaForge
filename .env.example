# ─────────────────────────────────────────────────────────────
# MediaForge — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# --- API Gateway (Go) ---
API_HTTP_ADDR=:8080
API_MAX_UPLOAD_BYTES=26214400        # 25 MiB
API_AUTH_TOKEN=dev-local-token       # bearer token for write endpoints (dev only)

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mediaforge
POSTGRES_PASSWORD=mediaforge
POSTGRES_DB=mediaforge
POSTGRES_DSN=postgres://mediaforge:mediaforge@postgres:5432/mediaforge?sslmode=disable

# --- Redis (rate limiting / cache) ---
REDIS_ADDR=redis:6379

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_PREFETCH=16
RABBITMQ_MAX_RETRIES=5
RABBITMQ_RETRY_TTL_MS=10000

# --- MinIO / S3 object storage ---
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mediaforge
S3_USE_SSL=false
S3_REGION=us-east-1

# --- Worker: image (Go) ---
IMAGE_METRICS_ADDR=:9102
IMAGE_THUMBNAIL_SIZE=256
IMAGE_RESIZE_MAX_DIM=1600

# --- Worker: OCR (Python) ---
OCR_METRICS_PORT=9103
OCR_LANGUAGES=eng+por
OCR_TESSERACT_CMD=tesseract

# --- Realtime gateway (TypeScript) ---
RT_HTTP_PORT=8090
RT_METRICS_PATH=/metrics

# --- Observability ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Distributed tracing (OpenTelemetry) ---
# Per-service OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME are set in
# docker-compose (Go services use OTLP/gRPC :4317, Python/Node use HTTP :4318).
OTEL_TRACES_ENABLED=true
OTEL_TRACES_SAMPLE_RATIO=1.0         # 1.0 = sample everything (lower in prod)
SERVICE_VERSION=dev
