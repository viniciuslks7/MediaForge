{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediaforge.dev/schemas/job.schema.json",
  "title": "Job",
  "description": "A unit of media work, published by the gateway on the media.jobs exchange and consumed by the workers. This schema is the single source of truth shared by the Go, Python and TypeScript contract tests.",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable job identifier; also the idempotency key."
    },
    "kind": {
      "type": "string",
      "enum": ["image", "ocr"],
      "description": "Pipeline the job flows through."
    },
    "status": {
      "type": "string",
      "enum": ["pending", "processing", "completed", "failed"]
    },
    "source_key": {
      "type": "string",
      "description": "Object-storage key of the uploaded original.",
      "minLength": 1
    },
    "source_mime": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "operations": {
      "type": "array",
      "items": { "type": "string", "enum": ["resize", "thumbnail", "webp", "grayscale"] },
      "uniqueItems": true,
      "description": "Image transformations to apply (image jobs only)."
    },
    "params": {
      "type": "object",
      "description": "Optional per-job overrides for image operations. Absent fields fall back to the worker's configured defaults.",
      "properties": {
        "resize_max_dim": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8000,
          "description": "Longest edge (px) of the 'resized' variant."
        },
        "thumbnail_size": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2000,
          "description": "Longest edge (px) of the square thumbnail."
        },
        "resize_format": {
          "type": "string",
          "enum": ["jpeg", "png", "webp"],
          "description": "Output format of the 'resized' variant (default jpeg)."
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Encoder quality for lossy formats (jpeg)."
        }
      },
      "additionalProperties": false
    },
    "attempt": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": ["job_id", "kind", "status", "source_key"],
  "additionalProperties": false
}
